<?php
$envPath = __DIR__ . '/../.env';
if (file_exists($envPath)) {
    $envVars = parse_ini_file($envPath);
    if ($envVars) {
        foreach ($envVars as $key => $value) {
            putenv("$key=$value");
            $_ENV[$key] = $value;
        }
    }
}

function get_env_var($key, $default = '') {
    $val = getenv($key);
    if ($val === false && isset($_ENV[$key])) {
        $val = $_ENV[$key];
    }
    return $val !== false ? $val : $default;
}

define('DB_HOST', get_env_var('DB_HOST', 'localhost'));
define('DB_USER', get_env_var('DB_USER', 'root'));
define('DB_PASS', get_env_var('DB_PASS', ''));
define('DB_NAME', get_env_var('DB_NAME', 'magang'));
define('APP_NAME', get_env_var('APP_NAME', 'MOPI PKL'));
define('SCHOOL_NAME', get_env_var('SCHOOL_NAME', 'SMK Negeri 1 Kota Contoh'));
define('SCHOOL_ID', (int)get_env_var('SCHOOL_ID', 1));
define('GOOGLE_CLIENT_ID', get_env_var('GOOGLE_CLIENT_ID', ''));

define('APP_URL', rtrim(get_env_var('APP_URL', 'http://localhost/magang'), '/'));

define('UPLOAD_PATH', __DIR__ . '/../uploads/');
define('UPLOAD_URL', APP_URL . '/uploads/');

function getDB() {
    static $pdo = null;
    if ($pdo === null) {
        try {
            $dsn = "mysql:host=" . DB_HOST . ";dbname=" . DB_NAME . ";charset=utf8mb4";
            $pdo = new PDO($dsn, DB_USER, DB_PASS, [
                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
                PDO::ATTR_EMULATE_PREPARES => false,
            ]);
        } catch (PDOException $e) {
            die(json_encode(['error' => 'Database connection failed: ' . $e->getMessage()]));
        }
    }
    return $pdo;
}
