RewriteEngine On

# Sesuaikan RewriteBase:
#   - Jika app di ROOT domain (https://domain.com/)  => RewriteBase /
#   - Jika app di SUBFOLDER (https://domain.com/magang/) => RewriteBase /magang/
RewriteBase /magang/

# Redirect trailing slashes
RewriteRule ^(.*)/$ $1 [L,R=301]

# Izinkan akses langsung ke file & folder yang ada (aset, upload, dll)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Semua route lainnya diarahkan ke index.php
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
